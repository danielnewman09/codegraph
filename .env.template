# >>> codegraph-db >>>
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codegraph
# <<< codegraph-db <<<

# Primary backend: SQLite (set to neo4j to switch; the registry also
# defaults to sqlite when this var is unset)
CODEGRAPH_BACKEND=sqlite
SQLITE_PATH=codegraph.sqlite3

LLM_BACKEND=openai                              # or anthropic, gemini
# LLM_BASE_URL=http://10.0.0.13:8080/v1
LLM_BASE_URL=https://api.deepseek.com/
LLM_API_KEY=<PAT>
# LLM_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:UD-IQ4_XS
LLM_MODEL=deepseek-v4-flash
# DeepSeek beta (thinking mode) does not support tool_choice='required'
LLM_TOOL_CHOICE=auto


ENRICH_LOG_DIR=codegraph/logs
