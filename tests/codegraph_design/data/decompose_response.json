{
  "description": "The Architecture Diagram Generator shall produce a single unified PlantUML diagram that renders the complete module/architecture view of a codegraph project. The generator shall query the codegraph Neo4j store for all modules/namespaces and their composition/dependency relationships, aggregate them into one coherent diagram, and emit valid PlantUML component-diagram syntax. The diagram shall use package notation for modules/namespaces, show key classes inside each package (medium detail level), render directed relationship arrows between packages, filter out packages below a configurable minimum entity count, produce deterministic output for the same input graph, and support standalone export to .puml files.",
  "nodes": [
    {
      "type": "LLR",
      "name": "Architecture Generation Interface",
      "description": "The Architecture Diagram Generator exposes a generate operation that accepts a LayerGraph reference and optional ArchitectureOptions (including min_entity_count), returns a valid PlantUML component-diagram string for valid inputs with at least one module, and signals an error for empty graphs or graphs with no modules.",
      "tags": [
        "design"
      ],
      "edges": [
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::generate::test_valid_graph",
          "target_type": "TestNode"
        },
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::generate::test_empty_graph",
          "target_type": "TestNode"
        },
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::generate::test_no_modules",
          "target_type": "TestNode"
        }
      ]
    },
    {
      "type": "LLR",
      "name": "Module/Namespace Query from Codegraph",
      "description": "The generator queries the codegraph for all ModuleNode and NamespaceNode entries, their composed class/interface/enum members, and dependency relationships between modules/namespaces, aggregating this data into an intermediate representation used for diagram generation.",
      "tags": [
        "design"
      ],
      "edges": [
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::query::test_returns_all_modules",
