          "target_type": "TestNode"
        }
      ]
    },
    {
      "type": "LLR",
      "name": "Dependency Arrow Rendering",
      "description": "The generator renders directed relationship arrows between package blocks using PlantUML component-diagram syntax, with each arrow indicating a dependency from a source package to a target package. Packages with no dependencies render without arrows.",
      "tags": [
        "design"
      ],
      "edges": [
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::arrow::test_arrows_between_packages",
          "target_type": "TestNode"
        },
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::arrow::test_no_arrows_no_deps",
          "target_type": "TestNode"
        }
      ]
    },
    {
      "type": "LLR",
      "name": "Minimum Entity Count Filtering",
      "description": "The generator filters out packages whose total entity count (classes + interfaces + enums composed within the package) is below the configurable min_entity_count threshold. Filtered packages and any relationship arrows referencing them are excluded from the output.",
      "tags": [
        "design"
      ],
      "edges": [
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::filter::test_excludes_below_threshold",
          "target_type": "TestNode"
        },
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::filter::test_includes_at_threshold",
          "target_type": "TestNode"
        },
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::filter::test_excludes_arrows_to_filtered",
          "target_type": "TestNode"
        }
      ]
    },
    {
      "type": "LLR",
      "name": "Deterministic Output",
      "description": "The generator produces identical PlantUML diagram strings for identical input graphs, ordering packages and their contents in a stable deterministic sequence (e.g., alphabetically by package name) regardless of internal query iteration order.",
      "tags": [
        "design"
      ],
      "edges": [
