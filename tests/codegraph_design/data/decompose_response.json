          "target_type": "TestNode"
        }
      ]
    },
    {
      "type": "LLR",
      "name": "Package Rendering with Class Content",
      "description": "The generator renders each aggregated module/namespace as a PlantUML package block containing its key classes, interfaces, and enums at medium detail level (name and key members shown), using package notation that matches the module/namespace hierarchy.",
      "tags": [
        "design"
      ],
      "edges": [
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::render_pkg::test_packages_rendered",
          "target_type": "TestNode"
        },
        {
          "relation_type": "COMPOSES",
          "target_uid": "vm::render_pkg::test_classes_in_packages",
          "target_type": "TestNode"
        },
