      {
        "method": "automated",
        "test_name": "test_export_to_file_signals_error_on_write_failure",
        "description": "Invoke export_to_file with a path to a non-writable directory and verify it signals a WriteFailureError.",
        "preconditions": [
          {
            "type": "assertion",
            "subject_qualified_name": "diagram_gen::LayerGraph::is_populated",
            "operator": "==",
            "expected_value": "true"
          }
        ],
        "actions": [
          {
            "type": "invoke",
            "callee_qualified_name": "diagram_gen::ArchitectureDiagramGenerator::export_to_file",
            "arguments": {
              "file_path": "/non-writable-dir/output.puml"
            }
          }
        ],
        "postconditions": [
          {
            "type": "assertion",
            "subject_qualified_name": "diagram_gen::ArchitectureDiagramGenerator::error_state",
            "operator": "==",
            "expected_value": "WriteFailureError"
          }
        ]
      },
      {
        "method": "automated",
        "test_name": "test_export_to_file_signals_error_for_invalid_path",
